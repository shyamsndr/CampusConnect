rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ─────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Checks the caller's Firestore USERS document for Admin role.
    // Result is cached per request — multiple calls cost only one read.
    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/USERS/$(request.auth.uid)).data.role == 'Admin';
    }

    // Checks the caller's Firestore USERS document for Staff role.
    function isStaff() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/USERS/$(request.auth.uid)).data.role == 'Staff';
    }

    // ── USERS ────────────────────────────────────────────────────────────────
    // Owner reads own doc. Admin reads any user doc (dashboard list + joins).
    // Only the fcm_token field may be updated by the owner (mobile FCM setup).
    // All other writes are handled by Cloud Functions (Admin SDK bypasses rules).
    match /USERS/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Users can only update their own fcm_token.
      allow update: if isOwner(userId)
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcm_token']);

      allow create, delete: if false;
    }

    // Helper function to validate event fields
    function isValidEventData(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.venue is string && data.venue.size() > 0 && data.venue.size() <= 200
        && data.status in ['published', 'cancelled']
        && data.event_date is timestamp;
    }

    // ── EVENTS ───────────────────────────────────────────────────────────────
    // Any authenticated user can read events (mobile app + admin portal).
    // Admins can create, update, and delete all events.
    // Staff can create events setting themselves as creator_id.
    // Staff can update or delete only events where they are the creator_id,
    // and cannot change the creator_id on update.
    // Existing legacy events without creator_id are manageable by Admin.
    match /EVENTS/{eventId} {
      allow read: if isAuthenticated();

      allow create: if (isAdmin() && isValidEventData(request.resource.data))
                   || (isStaff()
                       && request.resource.data.creator_id == request.auth.uid
                       && isValidEventData(request.resource.data));

      allow update: if (isAdmin() && isValidEventData(request.resource.data))
                   || (isStaff()
                       && resource.data.creator_id == request.auth.uid
                       && request.resource.data.creator_id == resource.data.creator_id
                       && isValidEventData(request.resource.data));

      allow delete: if isAdmin()
                   || (isStaff() && resource.data.creator_id == request.auth.uid);
    }

    // ── NOTIFICATIONS ─────────────────────────────────────────────────────────
    // Owner reads, updates (is_read only), and deletes own notifications.
    // Only admins can create notifications (batch writes for event alerts).
    match /NOTIFICATIONS/{notificationId} {
      // Read: owner only.
      allow read: if isAuthenticated()
                 && request.auth.uid == resource.data.user_id;

      // Create: admin only (event notification batches).
      allow create: if isAdmin();

      // Update: owner only, is_read field only.
      allow update: if isAuthenticated()
                   && request.auth.uid == resource.data.user_id
                   && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['is_read']);

      // Delete: owner only (mobile "Clear All" feature).
      allow delete: if isAuthenticated()
                   && request.auth.uid == resource.data.user_id;
    }

    // ── ISSUES ───────────────────────────────────────────────────────────────
    // Any authenticated user can read issues (mobile complaint tracking).
    // Only admins can write (status updates from admin dashboard).
    // Issue creation is handled by the submitComplaint Cloud Function (Admin SDK).
    match /ISSUES/{issueId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── ISSUE_REPORTS ────────────────────────────────────────────────────────
    // Any authenticated user can read reports (mobile: own reports; admin: all).
    // All writes handled by the submitComplaint Cloud Function (Admin SDK).
    match /ISSUE_REPORTS/{reportId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── ISSUE_STATUS_HISTORY ─────────────────────────────────────────────────
    // Any authenticated user can read status history.
    // Only admins can create history entries (admin dashboard batch writes).
    match /ISSUE_STATUS_HISTORY/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}