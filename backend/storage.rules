rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Event poster images ──────────────────────────────────────────────────
    // Readable by any authenticated user (mobile app + admin portal).
    // Writable by admins only (verified via Firestore USERS document).
    match /events/posters/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/USERS/$(request.auth.uid)).data.role == 'Admin';
    }

    // ── Complaint images ─────────────────────────────────────────────────────
    // Readable and writable by any authenticated user.
    // Mobile users upload complaint images before calling the Cloud Function.
    match /complaints/{fileName} {
      allow read, write: if request.auth != null;
    }

    // ── Default deny ─────────────────────────────────────────────────────────
    // All other paths are denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
