rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Event poster images ──────────────────────────────────────────────────
    // Readable by any authenticated user (mobile app + admin portal).
    // Staff can upload, update, and delete posters only in their own folder:
    // `events/posters/{userId}/{fileName}`.
    // Admins can upload, update, and delete in any folder including root `events/posters/{fileName}`.
    match /events/posters/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (firestore.get(/databases/(default)/documents/USERS/$(request.auth.uid)).data.role == 'Admin'
            || (firestore.get(/databases/(default)/documents/USERS/$(request.auth.uid)).data.role == 'Staff'
                && request.auth.uid == userId));
    }

    match /events/posters/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/USERS/$(request.auth.uid)).data.role == 'Admin';
    }

    // ── Complaint images ─────────────────────────────────────────────────────
    // Readable and writable by any authenticated user.
    // Mobile users upload complaint images before calling the Cloud Function.
    match /complaints/{fileName} {
      allow read, write: if request.auth != null;
    }

    // ── Default deny ─────────────────────────────────────────────────────────
    // All other paths are denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
