# CampusConnect Cloud Functions – Email Configuration
#
# Copy this file to .env and fill in your real SMTP credentials.
# NEVER commit the .env file to Git.
#
# ── Special test values ──────────────────────────────────────────────────────
#   SMTP_HOST=mock   → Simulate a successful email send (logs a message, no network)
#   SMTP_HOST=fail   → Simulate a failed email send (tests rollback behaviour)
# ─────────────────────────────────────────────────────────────────────────────
#
# ── Real SMTP provider examples ───────────────────────────────────────────────
#
#   Gmail (App Password required – enable 2FA then generate an App Password):
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=587
#     SMTP_USER=you@gmail.com
#     SMTP_PASSWORD=<16-char app password>
#     EMAIL_FROM=CampusConnect Administration <you@gmail.com>
#
#   Outlook / Office 365:
#     SMTP_HOST=smtp.office365.com
#     SMTP_PORT=587
#     SMTP_USER=you@outlook.com
#     SMTP_PASSWORD=<your password>
#     EMAIL_FROM=CampusConnect Administration <you@outlook.com>
#
#   SendGrid:
#     SMTP_HOST=smtp.sendgrid.net
#     SMTP_PORT=587
#     SMTP_USER=apikey
#     SMTP_PASSWORD=<your SendGrid API key>
#     EMAIL_FROM=CampusConnect Administration <noreply@yourdomain.com>
#
#   Mailgun:
#     SMTP_HOST=smtp.mailgun.org
#     SMTP_PORT=587
#     SMTP_USER=postmaster@mg.yourdomain.com
#     SMTP_PASSWORD=<your Mailgun SMTP password>
#     EMAIL_FROM=CampusConnect Administration <noreply@mg.yourdomain.com>
#
# ─────────────────────────────────────────────────────────────────────────────

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
